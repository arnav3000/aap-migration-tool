# AAP Bridge UI (optional) — multi-stage build.
# Stage 1 builds the static Vite app; stage 2 serves it via nginx and
# reverse-proxies /api/v1 to the API container (no CORS changes needed).
ARG NODE_VERSION=20
FROM docker.io/library/node:${NODE_VERSION}-alpine AS build

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
RUN npm run build

FROM registry.access.redhat.com/ubi9/nginx-126 AS runtime

LABEL org.opencontainers.image.title="aap-bridge-ui" \
      org.opencontainers.image.description="Optional web UI for AAP Bridge (PatternFly, AWX-style job output)" \
      org.opencontainers.image.source="https://github.com/arnav3000/aap-migration-tool" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

# nginx-126 image serves from /opt/app-root/src by default.
COPY --from=build /app/dist/ /opt/app-root/src/
# Full main config (documented ubi nginx-126 Dockerfile pattern: replace
# /etc/nginx/nginx.conf, which is chowned to UID 1001 in the base image).
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080
USER 1001

# The base image defaults to the S2I usage script (prints help and exits);
# run nginx in the foreground instead.
CMD nginx -g "daemon off;"
